HTTP_ADDR=:8080
DATABASE_URL=postgres://blog:blog@localhost:5432/blog?sslmode=disable
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=15s
DB_MAX_CONNS=20
# Comma-separated CIDRs; empty means forwarded headers are never trusted.
TRUSTED_PROXIES=
# Required. Secret for the HMAC of client IPs; raw IPs are never stored.
IP_HASH_SECRET=change-me
